APP_NAME=Mardon Portfolio API
ENVIRONMENT=development

# Database: Lokal uchun SQLite, production uchun PostgreSQL
# Namuna (PostgreSQL): postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./portfolio.db

# CORS: Production'da faqat kerakli domenlarni qo'shing
# Namuna: https://mardon-portfolio.onrender.com
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
